<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Telegram YouTube</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { font-family: sans-serif; background: #111; color: white; margin: 0; padding: 10px; }
        .search-box { display: flex; gap: 5px; margin-bottom: 20px; }
        input { flex: 1; padding: 10px; border-radius: 5px; border: none; }
        button { padding: 10px; background: #f00; color: white; border: none; border-radius: 5px; cursor: pointer; }
        .video-card { margin-bottom: 20px; background: #222; border-radius: 10px; overflow: hidden; }
        .video-card img { width: 100%; display: block; }
        .video-card h3 { padding: 10px; font-size: 16px; margin: 0; }
        iframe { width: 100%; height: 250px; border: none; }
    </style>
</head>
<body>
    <div class="search-box">
        <input type="text" id="query" placeholder="Что поищем?">
        <button onclick="search()">Поиск</button>
    </div>
    <div id="results"></div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        async function search() {
            const query = document.getElementById('query').value;
            const resultsDiv = document.getElementById('results');
            resultsDiv.innerHTML = 'Загрузка...';

            try {
                const response = await fetch(`https://invidious.lunar.icu/api/v1/search?q=${encodeURIComponent(query)}`);
                const data = await response.json();

                resultsDiv.innerHTML = '';
                data.forEach(video => {
                    if (video.type === 'video') {
                        const card = document.createElement('div');
                        card.className = 'video-card';
                        card.innerHTML = `
                            <img src="${video.videoThumbnails[0].url}" onclick="playVideo('${video.videoId}')">
                            <h3>${video.title}</h3>
                        `;
                        resultsDiv.appendChild(card);
                    }
                });
            } catch (e) {
                resultsDiv.innerHTML = 'Ошибка загрузки. Попробуйте еще раз.';
            }
        }

        function playVideo(id) {
            const resultsDiv = document.getElementById('results');
            resultsDiv.innerHTML = `
                <button onclick="location.reload()" style="margin-bottom:10px;">← Назад</button>
                <iframe src="https://invidious.lunar.icu/embed/${id}" allowfullscreen></iframe>
            `;
        }
    </script>
</body>
</html>
